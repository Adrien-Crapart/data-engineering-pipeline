FROM apache/airflow:3.1.7-python3.12

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY orchestration/airflow/pyproject.toml /tmp/pyproject.toml
RUN cd /tmp && uv pip install --system --no-cache -r pyproject.toml

USER airflow
