      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 96 },
      "datasource": { "uid": "loki" },
      "targets": [
        { "expr": "{job=\"docker\", container_name=\"airflow-scheduler\"} |~ \"(?i)(error|exception|traceback|warning|import|module|no module|syntaxerror|cannot)\"", "legendFormat": "", "refId": "A" }
      ],
      "options": {
