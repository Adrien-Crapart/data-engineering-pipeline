{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Pipeline Duration (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(pipeline_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 - {{pipeline_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "title": "Pipeline Run Status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "pipeline_last_run_success",
          "legendFormat": "{{pipeline_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FAILED", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "title": "Pipeline Failures (total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(pipeline_failures_total)",
          "legendFormat": "Total Failures"
        }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 1, "color": "red" } ] } },
        "overrides": []
      }
    },
    {
      "title": "API Response Time (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(api_response_time_seconds_bucket[5m]))",
          "legendFormat": "p95 - {{endpoint}} / {{city}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "title": "Ingestion Latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(ingestion_latency_seconds_bucket[5m]))",
          "legendFormat": "p95 - {{source}} / {{city}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "title": "Records Ingested (total)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(records_ingested_total[5m])) by (source)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "title": "Data Freshness (seconds since last update)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "data_freshness_seconds",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 21600, "color": "yellow" },
              { "value": 43200, "color": "red" }
            ]
          }
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["weather", "pipeline", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Weather Pipeline Overview",
  "uid": "weather-pipeline-overview"
}
