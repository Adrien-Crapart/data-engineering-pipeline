# ============================================================
# Weather Data Engineering Pipeline - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# === Docker Compose project name ===
COMPOSE_PROJECT_NAME=weather-pipeline

# === OpenWeather API ===
OPENWEATHER_API_KEY=your_api_key_here

# === Cities to monitor (comma-separated) ===
WEATHER_CITIES=Paris,Lyon,Marseille,Toulouse,Nice

# === PostgreSQL (data warehouse — DLT, dbt, GX, Soda target) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# === MinIO (S3-compatible Data Lake) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=data-lake

# === Grafana ===
GRAFANA_ADMIN_PASSWORD=admin

# === Metabase ===
METABASE_DB_USER=metabase_user
METABASE_DB_PASSWORD=metabase_password

# === Monitoring ===
# MailHog SMTP (dev email testing)
SMTP_HOST=mailhog
SMTP_PORT=1025

# === Project root (absolute host path, used by DockerOperator mounts) ===
# Set this to the absolute path of the project on your Docker host.
# On Linux/Mac: PROJECT_ROOT=/home/user/data-engineering-pipeline
# On Windows (Docker Desktop): PROJECT_ROOT=/c/Users/user/data-engineering-pipeline
PROJECT_ROOT=.

# === Airflow ===
AIRFLOW__API__SECRET_KEY=RMU3ZDFjNzk4YjI0M2I4OTdhZGE5NmU0Nzc2ZWEyNDQ=
